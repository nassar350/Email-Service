# =============================================================
# Email Management Service - environment variable reference
# Copy this file to .env and fill in real values locally.
# NEVER commit real secrets. .env is git-ignored.
# =============================================================

# Mailjet credentials (REQUIRED unless MAILJET_SKIP_STARTUP_VALIDATION=true)
MAILJET__APIKEY=
MAILJET__SECRETKEY=
MAILJET__FROMEMAIL=
MAILJET__FROMNAME=Email Management Service

# Optional: Mailjet webhook authentication (Basic auth or Bearer token).
# If left empty, the webhook endpoint accepts unauthenticated requests.
MAILJET__WEBHOOKUSERNAME=
MAILJET__WEBHOOKPASSWORD=
MAILJET__WEBHOOKTOKEN=
MAILJET__SKIPSTARTUPVALIDATION=false

# Mysql connection string (REQUIRED)
# Example: Server=localhost;Port=3306;Database=emailservice;Uid=ems_user;Pwd=secret;
DATABASE_CONNECTION_STRING=

# Optional: generate a bootstrap API key on startup when none exist (true/false)
API_KEY_BOOTSTRAP=true

# Local file storage base path (defaults to <content-root>/storage)
STORAGE_PATH=

# Worker tuning
WORKER__POLLINGINTERVALSECONDS=10
WORKER__BATCHSIZE=5

# Rate limiting for POST /api/v1/emails/send (per client IP)
RATELIMITING__SENDPERMITLIMIT=20
RATELIMITING__SENDWINDOWSECONDS=60